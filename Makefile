GO_VERSION := go1.25.12

.PHONY: verify verify-offline

verify:
	GOTOOLCHAIN=$(GO_VERSION) go test ./...
	GOTOOLCHAIN=$(GO_VERSION) go test -race ./...
	GOTOOLCHAIN=$(GO_VERSION) go vet ./...
	GOTOOLCHAIN=$(GO_VERSION) go build ./...

verify-offline:
	GOTOOLCHAIN=$(GO_VERSION) GOPROXY=off go test ./...
	GOTOOLCHAIN=$(GO_VERSION) GOPROXY=off go test -race ./...
	GOTOOLCHAIN=$(GO_VERSION) GOPROXY=off go vet ./...
	GOTOOLCHAIN=$(GO_VERSION) GOPROXY=off go build ./...

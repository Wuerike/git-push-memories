{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "git-push-memories candidate v1",
  "type": "object",
  "x-maxUtf8Bytes": 262144,
  "additionalProperties": false,
  "required": ["target_path", "section_id", "replacement", "source_paths"],
  "properties": {
    "target_path": { "type": "string", "x-maxUtf8Bytes": 1024 },
    "section_id": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "replacement": { "type": "string", "x-maxUtf8Bytes": 131072 },
    "source_paths": {
      "type": "array",
      "maxItems": 16,
      "items": { "type": "string", "x-maxUtf8Bytes": 1024 }
    }
  }
}
